#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    ZMK_MACRO(recover, bindings = <&out OUT_RECOVER>;)
    ZMK_MACRO(change, bindings = <&out OUT_FN>;)
    ZMK_MACRO(fn_win, bindings = <&out OUT_FN_WIN>;)

    ZMK_MACRO(en_bootloader, bindings = <&bootloader>;)
    ZMK_MACRO1(MA,bindings=<&kp 0x770000>;)

    long_press_recover:l1 {
        compatible = "zmk,behavior-hold-tap";
        label = "l1";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&recover>, <&none>;
    };

    long_press_change:l2{
        compatible = "zmk,behavior-hold-tap";
        label = "lp_change";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&change>, <&none>;
    };
    long_press_bootloader:l3{
        compatible = "zmk,behavior-hold-tap";
        label = "lp_bootloader";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&en_bootloader>, <&none>;
    };
    long_press_fn_win:l4{
        compatible = "zmk,behavior-hold-tap";
        label = "lp_fn_win";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&fn_win>, <&none>;
    };


    macro {

        lg_en: lg_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp_unshift LC(LS(N8))>;
            label = "LG_EN";
        };

        lg_ru: lg_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp_unshift LC(LS(N9))>;
            label = "LG_RU";
        };

        switch_en: switch_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &lg_en>;
            label = "SWITCH_EN";
        };

        switch_ru: switch_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &lg_ru>;
            label = "SWITCH_RU";
        };

        ml: ml {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1 &key_on MACRO_PLACEHOLDER &layer_on 3>,
                <&macro_pause_for_release>,
                <&macro_param_1to1 &key_off MACRO_PLACEHOLDER &layer_off 3>;

            label = "ML";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        ruen: ruen {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&lg_en &macro_param_1to1 &kp MACRO_PLACEHOLDER &lg_ru>;
            label = "RUEN";
        };

        enru: enru {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&lg_ru &macro_param_1to1 &kp MACRO_PLACEHOLDER &lg_en>;
            label = "ENRU";
        };

        tag_open: tag_open {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp GT &kp LEFT>;
            label = "TAG_OPEN";
        };

        tag_open_ru: tag_open_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&lg_en &kp_unshift LT &kp GT &kp LEFT &lg_ru>;
            label = "TAG_OPEN_RU";
        };

        tag_close: tag_close {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp FSLH &kp GT &kp LEFT>;
            label = "TAG_CLOSE";
        };

        tag_close_ru: tag_close_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&lg_en &kp_unshift LT &kp FSLH &kp GT &kp LEFT &lg_ru>;
            label = "TAG_CLOSE_RU";
        };

        paraphesis_pair: paraphesis_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp_unshift LPAR &kp RPAR &kp LEFT>;
            label = "PARAPHESIS_PAIR";
        };

        bracket_pair: bracket_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
            label = "BRACKET_PAIR";
        };

        bracket_pair_ru: bracket_pair_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&lg_en &kp_unshift LBKT &kp RBKT &kp LEFT &lg_ru>;
            label = "BRACKET_PAIR_RU";
        };

        braces_pair: braces_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
            label = "BRACES_PAIR";
        };

        braces_pair_ru: braces_pair_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&lg_en &kp_unshift LBRC &kp RBRC &kp LEFT &lg_ru>;
            label = "BRACES_PAIR_RU";
        };

        in_below: in_below {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp_unshift END &kp LS(RET)>;
            label = "IN_BELOW";
        };

        in_above: in_above {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp_unshift HOME &kp LS(RET) &kp UP>;
            label = "IN_ABOVE";
            wait-ms = <0>;
        };

        rshift_down: rshift_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp RSHFT>;

            label = "RSHIFT_DOWN";
        };

        kp_unshift: kp_rsup {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_release>,
                <&kp RSHFT>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "KP_RSUP";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        switch_en_tablet: switch_en_tablet {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LC(SPACE)>;
            label = "SWITCH_EN_TABLET";
        };

        switch_ru_tablet: switch_ru_tablet {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &kp LC(SPACE)>;
            label = "SWITCH_RU_TABLET";
        };

        delete_to_row_start: delete_to_row_start {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(HOME) &kp BSPC>;
            label = "DELETE_TO_ROW_START";
        };

        select_row: select_row {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(DOWN)>;
            label = "SELECT_ROW";
        };

    };

    behaviors {

        key_on: key_on {
            compatible = "zmk,behavior-key-toggle";
            label = "KEY_ON";
            #binding-cells = <1>;
        };

        key_off: key_off {
            compatible = "zmk,behavior-key-toggle";
            label = "KEY_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        layer_on: layer_on {
            compatible = "zmk,behavior-toggle-layer";
            label = "LAYER_ON";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        layer_off: layer_off {
            compatible = "zmk,behavior-toggle-layer";
            label = "LAYER_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        hrml: hrml {
            compatible = "zmk,behavior-hold-tap";
            label = "HRML";
            bindings = <&ml>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <100>;
            flavor = "tap-preferred";
        };

        // td_bootloader: td_bootloader {
        //     compatible = "zmk,behavior-tap-dance";
        //     label = "TD_BOOTLOADER";
        //     #binding-cells = <0>;
        //     bindings = <&none>, <&bootloader>;
        // };

        u_caps_word: u_caps_word {
            compatible = "zmk,behavior-mod-morph";
            label = "U_CAPS_WORD";
            bindings = <&caps_word>, <&kp CAPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        u_caps_word_ru: u_caps_word_ru {
            compatible = "zmk,behavior-mod-morph";
            label = "U_CAPS_WORD_RU";
            bindings = <&rshift_down>, <&kp CAPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mt_ruen: mt_ruen {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_RUEN";
            #binding-cells = <2>;
            bindings = <&kp>, <&ruen>;

            quick-tap-ms = <100>;
            global-quick-tap;
            flavor = "tap-preferred";
            tapping-term-ms = <170>;
        };

        undo_redo: undo_redo {
            compatible = "zmk,behavior-mod-morph";
            label = "UNDO_REDO";
            bindings = <&kp_unshift LC(Z)>, <&kp_unshift LC(Y)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        p_HOME: p_HOME {
            compatible = "zmk,behavior-mod-morph";
            label = "P_HOME";
            bindings = <&kp_unshift HOME>, <&kp_unshift HOME>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        p_END: p_END {
            compatible = "zmk,behavior-mod-morph";
            label = "P_END";
            bindings = <&kp_unshift END>, <&kp_unshift END>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        lt_unshift: lt_unshift {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_UNSHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "balanced";
            bindings = <&mo>, <&kp_unshift>;
        };

        up_ignore_cw: up_ignore_cw {
            compatible = "zmk,behavior-mod-morph";
            label = "UP_IGNORE_CW";
            bindings = <&kp UP>, <&kp UP>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        down_ignore_cw: down_ignore_cw {
            compatible = "zmk,behavior-mod-morph";
            label = "DOWN_IGNORE_CW";
            bindings = <&kp DOWN>, <&kp DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        left_ignore_cw: left_ignore_cw {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFT_IGNORE_CW";
            bindings = <&kp LEFT>, <&kp LEFT>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        right_ignore_cw: right_ignore_cw {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHT_IGNORE_CW";
            bindings = <&kp RIGHT>, <&kp RIGHT>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        mt_unshift: mt_unshift {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_UNSHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp_unshift>;

            quick-tap-ms = <100>;
        };

    };

    combos1 {
        compatible = "zmk,combos";

        combo_en {
            bindings = <&switch_en>;
            key-positions = <30 31>;
            layers = <0 1>;
        };

        combo_ru {
            bindings = <&switch_ru>;
            key-positions = <36 37>;
            layers = <0 1>;
        };

        combo_en_tablet {
            bindings = <&switch_en_tablet>;
            key-positions = <30 32>;
            layers = <0 1>;
        };

        combo_ru_tablet {
            bindings = <&switch_ru_tablet>;
            key-positions = <35 37>;
            layers = <0 1>;
        };

        combo_jz {
            timeout-ms = <1000>;
            layers = <4>;
            key-positions = <49 56>; //fn+j+z
            bindings = <&long_press_recover 0 0>;
        };
        combo_xl {
            timeout-ms = <1000>;
            layers =< 4>;
            key-positions = <57 51>; //fn+x+l
            bindings = <&long_press_change 0 0>;
        };
        combo_b {
            timeout-ms = <1000>;
            layers =< 4>;
            //slow-release = <true>;
            key-positions = <60>; //fn+b
            bindings = <&out OUT_BAT>;
        };

        combo_win_l {
            timeout-ms = <1000>;
            layers =< 4>;
            //slow-release = <true>;
            key-positions = <68>; //fn+win
            bindings = <&long_press_fn_win 0 0>;
        };

    };

    td0 {
        compatible = "zmk,behavior-tap-dance";
        label = "TAPD_LAYER";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings =<&mo 0>,<&mo 0>,<&mo 0>,<&mo 0>,<&to 0>;
    };
    ZMK_MACRO(bt_pair0, bindings = <&bt BT_PAIR 0>;)
    ZMK_MACRO(bt_pair1, bindings = <&bt BT_PAIR 1>;)
    ZMK_MACRO(bt_pair2, bindings = <&bt BT_PAIR 2>;)
    ZMK_MACRO(bt_pair3, bindings = <&bt BT_PAIR 3>;)
    ZMK_MACRO(bt_recon_0, bindings = <&bt BT_SEL 0>;)
    ZMK_MACRO(bt_recon_1, bindings = <&bt BT_SEL 1>;)
    ZMK_MACRO(bt_recon_2, bindings = <&bt BT_SEL 2>;)
    ZMK_MACRO(bt_recon_3, bindings = <&bt BT_SEL 3>;)



    bt_pair_0: bt_pair_0 {
        compatible = "zmk,behavior-hold-tap";
        label = "bt_pair0";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair0>, <&bt_recon_0>;
    };
    bt_pair_1: bt_pair_1 {
        compatible = "zmk,behavior-hold-tap";
        label = "bt_pair1";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair1>, <&bt_recon_1>;
    };
    bt_pair_2: bt_pair_2 {
        compatible = "zmk,behavior-hold-tap";
        label = "bt_pair2";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair2>, <&bt_recon_2>;
    };
    bt_pair_3: bt_pair_3 {
        compatible = "zmk,behavior-hold-tap";
        label = "bt_pair3";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair3>, <&bt_recon_3>;
    };
    uc:user_custom {
        compatible = "zmk,behavior-key-press";
        label ="user_custom";
        #binding-cells =<1>;
    };

	keymap {
    	compatible = "zmk,keymap";

        // 0
        en {
        bindings = <
        &kp ESC             &kp F1                 &kp F2                 &kp F3                 &kp F4                  &kp F5              &kp F6          &kp F7          &kp F8              &kp F9             &kp F10               &kp F11          &kp F12               &kp DEL
        &kp GRAVE           &kp N1                 &kp N2                 &kp N3                 &kp N4                  &kp N5              &kp N6          &kp N7          &kp N8              &kp N9             &kp N0                &kp MINUS        &kp EQUAL             &kp BSPC
        &kp TAB             &kp Q                  &kp W                  &kp F                  &kp P                   &kp G               &kp J           &kp L           &kp U               &kp Y              &kp SEMI              &kp LBKT         &kp RBKT              &kp BSLH
        &kp ESC             &mt LGUI A             &mt LALT R             &mt LCTRL S            &mt LSHFT T             &kp D               &kp H           &mt LSHFT N     &mt LCTRL E         &mt LALT I         &mt LGUI O            &kp SQT                                &kp RET
        &kp LSHFT           &kp Z                  &kp X                  &kp C                  &kp V                   &kp B               &kp K           &kp M           &kp COMMA           &kp DOT            &kp FSLH              &kp RSHFT
        &kp LCTRL           &kp LGUI               &kp LALT                                      &lt 7 SPACE                                                                                     &lt 5 RET          &kp RALT              &kp LEFT         &kp UP    &kp DOWN    &kp RIGHT
        //
        &mo 2               &out OUT_BLE           &out OUT_24G           &out OUT_CHG           &out OUT_CHGD
            >;
        };

        // 1
        ru  {
        bindings = <
        &kp ESC             &kp F1                 &kp F2                 &kp F3                 &kp F4                  &kp F5              &kp F6          &kp F7          &kp F8              &kp F9             &kp F10               &kp F11          &kp F12               &kp DEL
        &kp GRAVE           &kp N1                 &kp N2                 &kp N3                 &kp N4                  &kp N5              &kp N6          &kp N7          &kp N8              &kp N9             &kp N0                &kp MINUS        &kp EQUAL             &kp BSPC
        &kp TAB             &kp Q                  &kp W                  &kp E                  &kp R                   &kp T               &kp Y           &kp U           &kp I               &kp O              &kp P                 &kp LBKT         &kp RBKT              &kp BSLH
        &kp ESC             &mt LGUI A             &mt LALT S             &mt LCTRL D            &mt LSHFT F             &kp G               &kp H           &mt LSHFT J     &mt LCTRL K         &mt LALT L         &mt LGUI SEMI         &kp SQT                                &kp RET
        // &kp ESC             &hrml LGUI A           &hrml LALT S           &hrml LCTRL D          &mt LSHFT F             &kp G               &kp H           &mt LSHFT J     &hrml LCTRL K       &hrml LALT L       &hrml LGUI SEMI       &kp SQT                                &kp RET
        &kp LSHFT           &kp Z                  &kp X                  &kp C                  &kp V                   &kp B               &kp N           &kp M           &kp COMMA           &kp DOT            &kp FSLH              &kp RSHFT
        &kp LCTRL           &kp LGUI               &kp LALT                                      &lt 7 SPACE                                                                                     &lt 6 RET          &kp RALT              &kp LEFT         &kp UP    &kp DOWN    &kp RIGHT
        //
        &none               &none                  &none                  &none                  &none
            >;
        };

        // 2
        gam {
        bindings = <
        &kp ESC             &kp F1                 &kp F2                 &kp F3                 &kp F4                  &kp F5              &kp F6          &kp F7          &kp F8              &kp F9             &kp F10               &kp F11          &kp F12               &kp DEL
        &kp GRAVE           &kp N1                 &kp N2                 &kp N3                 &kp N4                  &kp N5              &kp N6          &kp N7          &kp N8              &kp N9             &kp N0                &kp MINUS        &kp EQUAL             &kp BSPC
        &kp TAB             &kp Q                  &kp W                  &kp E                  &kp R                   &kp T               &kp Y           &kp U           &kp I               &kp O              &kp P                 &kp LBKT         &kp RBKT              &kp BSLH
        &kp CLCK            &kp A                  &kp S                  &kp D                  &kp F                   &kp G               &kp H           &kp J           &kp K               &kp L              &kp SEMI              &kp SQT                                &kp RET
        &kp LSHFT           &kp Z                  &kp X                  &kp C                  &kp V                   &kp B               &kp N           &kp M           &kp COMMA           &kp DOT            &kp FSLH              &kp RSHFT
        &kp LCTRL           &kp LGUI               &kp LALT                                      &kp SPACE                                                                                       &kp RALT           &mo 5                 &kp LEFT         &kp UP    &kp DOWN    &kp RIGHT
        //
        &none               &none                  &none                  &none                  &none
            >;
        };

        // 3
        mac {
        bindings = <
        &kp ESC             &kp F1                 &kp F2                 &kp F3                 &kp F4                  &kp F5              &kp F6          &kp F7          &kp F8              &kp F9             &kp F10               &kp F11          &kp F12               &kp DEL
        &kp GRAVE           &kp N1                 &kp N2                 &kp N3                 &kp N4                  &kp N5              &kp N6          &kp N7          &kp N8              &kp N9             &kp N0                &kp MINUS        &kp EQUAL             &kp BSPC
        &kp TAB             &kp Q                  &kp W                  &kp E                  &kp R                   &kp T               &kp Y           &kp U           &kp I               &kp O              &kp P                 &kp LBKT         &kp RBKT              &kp BSLH
        &kp ESC             &mt LCTRL A            &mt LALT S             &mt LGUI D             &mt LSHFT F             &kp G               &kp H           &mt LSHFT J     &mt GUI K           &mt LALT L         &mt LCTRL SEMI        &kp SQT                                &kp RET
        &kp LSHFT           &kp Z                  &kp X                  &kp C                  &kp V                   &kp B               &kp N           &kp M           &kp COMMA           &kp DOT            &kp FSLH              &kp RSHFT
        &kp LCTRL           &kp LALT               &kp LGUI                                      &lt 4 SPACE                                                                                     &lt 5 RET          &kp RALT              &kp LEFT         &kp UP    &kp DOWN    &kp RIGHT
        //
        &none               &none                  &none                  &none                  &none
            >;
        };

        // 3
        mac_nav {
        bindings = <
                      //f1                    //f2                    //f3                                //f4                        //f5            //f6              //f7            //f8              //f9                  //f10           //f11                         //f12
        &trans    &kp C_BRIGHTNESS_DEC    &kp C_BRIGHTNESS_INC        &uc LG(TAB)                         &uc C_AL_MY_COMPUTER    &kp C_AC_SEARCH     &uc LG(L)       &kp C_PREVIOUS  &kp C_PLAY_PAUSE    &kp C_NEXT            &kp C_MUTE  &kp C_VOLUME_DOWN           &kp C_VOLUME_UP      &trans
        &trans    &kp F1                  &kp F2                      &kp F3                              &kp F4                  &kp F5              &kp F6          &kp F7          &kp F8              &kp F9                &kp F10     &kp F11                     &kp F12              &trans
        &trans    &kp DEL                 &kp LC(LS(TAB))             &kp TAB                             &kp LC(TAB)             &kp K_APP           &kp PG_UP       &kp HOME        &kp UP              &kp END               &in_above   &trans                      &trans               &uc LG(LS(S))
        &kp CAPS  &kp LGUI                &kp LALT                    &kp LCTRL                           &kp LSHFT               &kp PSCRN           &kp PG_DN       &kp LEFT        &kp DOWN            &kp RIGHT             &kp RET     &kp INS                             &trans
        &trans    &undo_redo              &kp LC(X)                   &kp LC(C)                           &kp LC(V)               &kp LC(Y)           &select_row     &kp BSPC        &kp DEL             &delete_to_row_start  &in_below                                       &uc LG(DOT)
        &trans    &trans                  &trans                           &trans                                                                                                     &kp RCTRL           &trans                &kp HOME    &kp PG_UP    &kp PG_DN   &kp END
        //
        &none     &none                   &none                       &none                               &none
            >;
        };

        // 5
        sym {
        bindings = <
                    //f1                    //f2                    //f3                                //f4                        //f5            //f6              //f7            //f8              //f9        //f10           //f11                         //f12
        &trans  &kp C_BRIGHTNESS_DEC    &kp C_BRIGHTNESS_INC        &uc LG(TAB)                         &uc C_AL_MY_COMPUTER    &kp C_AC_SEARCH     &uc LG(L)       &kp C_PREVIOUS  &kp C_PLAY_PAUSE    &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_DOWN           &kp C_VOLUME_UP      &trans
        &trans  &bt_pair_0 0 0          &bt_pair_1 0 0              &bt_pair_2 0 0                      &bt_pair_3 0 0          &trans              &trans          &trans          &trans              &trans      &trans      &trans                      &kp C_AL_CALC        &trans
        &trans  &kp DQT                 &kp LT                      &kp EQUAL                           &kp GT                  &kp GRAVE           &kp CARET       &kp LBKT        &kp UNDER           &kp RBKT       &kp SQT           &trans                      &trans               &uc LG(LS(S))
        &trans  &mt LGUI BSLH           &mt LALT LPAR               &mt LCTRL MINUS                     &mt LSHFT RPAR          &kp PLUS            &kp PRCNT       &mt LSHFT LBRC  &mt LCTRL SEMI      &mt LALT RBRC  &mt LGUI EXCL     &trans                              &trans
        &trans  &kp HASH                &kp STAR                    &kp COLON                           &kp FSLH                &kp AT              &enru HASH      &kp PIPE        &kp TILDE           &kp AMPS       &kp DLLR                                              &uc LG(DOT)
        &trans  &trans                  &trans                           &trans                                                                                                     &kp RCTRL           &trans      &kp HOME    &kp PG_UP    &kp PG_DN   &kp END
        //
        &none   &none                   &none                       &none                               &none
            >;
        };

        // 6
        sym_ru {
        bindings = <
                    //f1                    //f2                    //f3                                //f4                        //f5            //f6              //f7            //f8              //f9        //f10           //f11                         //f12
        &trans  &kp C_BRIGHTNESS_DEC    &kp C_BRIGHTNESS_INC        &uc LG(TAB)                         &uc C_AL_MY_COMPUTER    &kp C_AC_SEARCH     &uc LG(L)       &kp C_PREVIOUS  &kp C_PLAY_PAUSE    &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_DOWN           &kp C_VOLUME_UP      &trans
        &trans  &bt_pair_0 0 0          &bt_pair_1 0 0              &bt_pair_2 0 0                      &bt_pair_3 0 0          &trans              &trans          &trans          &trans              &trans      &trans      &trans                      &kp C_AL_CALC        &trans
        &trans  &kp AT                  &ruen LT                    &kp EQUAL                           &ruen GT                &ruen GRAVE         &ruen CARET     &ruen LBKT           &kp UNDER               &ruen RBKT          &ruen SQT                  &trans                      &trans               &uc LG(LS(S))
        &trans  &mt LGUI BSLH           &mt LALT LPAR               &mt LCTRL MINUS                     &mt LSHIFT RPAR         &kp PLUS            &kp PRCNT       &mt_ruen LSHFT LBRC  &mt LCTRL DLLR &mt_ruen LALT RBRC  &mt LGUI EXCL      &trans                              &trans
        &trans  &ruen HASH             &kp STAR                     &kp CARET                           &kp PIPE                &ruen AT            &kp HASH        &ruen PIPE           &ruen TILDE             &ruen AMPS          &ruen DLLR                                                     &uc LG(DOT)
        &trans  &trans                  &trans                           &trans                                                                                                     &kp RCTRL           &trans      &kp HOME    &kp PG_UP    &kp PG_DN   &kp END
        //
        &none   &none                   &none                       &none                               &none
            >;
        };

        // 7
        nav {
        bindings = <
                      //f1                    //f2                    //f3                                //f4                        //f5            //f6              //f7            //f8              //f9                  //f10           //f11                         //f12
        &trans    &kp C_BRIGHTNESS_DEC    &kp C_BRIGHTNESS_INC        &uc LG(TAB)                         &uc C_AL_MY_COMPUTER    &kp C_AC_SEARCH     &uc LG(L)       &kp C_PREVIOUS  &kp C_PLAY_PAUSE    &kp C_NEXT            &kp C_MUTE  &kp C_VOLUME_DOWN           &kp C_VOLUME_UP      &trans
        &trans    &kp F1                  &kp F2                      &kp F3                              &kp F4                  &kp F5              &kp F6          &kp F7          &kp F8              &kp F9                &kp F10     &kp F11                     &kp F12              &trans
        &trans    &kp DEL                 &kp LC(LS(TAB))             &kp TAB                             &kp LC(TAB)             &kp K_APP           &kp PG_UP       &kp HOME        &kp UP              &kp END               &in_above   &trans                      &trans               &uc LG(LS(S))
        &kp CAPS  &kp LGUI                &kp LALT                    &kp LCTRL                           &kp LSHFT               &kp PSCRN           &kp PG_DN       &kp LEFT        &kp DOWN            &kp RIGHT             &kp RET     &kp INS                             &trans
        &trans    &undo_redo              &kp LC(X)                   &kp LC(C)                           &kp LC(V)               &kp LC(Y)           &select_row     &kp BSPC        &kp DEL             &delete_to_row_start  &in_below                                       &uc LG(DOT)
        &trans    &trans                  &trans                           &trans                                                                                                     &kp RCTRL           &trans                &kp HOME    &kp PG_UP    &kp PG_DN   &kp END
        //
        &none     &none                   &none                       &none                               &none
            >;
        };

	};
};

	
