#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    ZMK_MACRO(recover, bindings = <&out OUT_RECOVER>;)
    ZMK_MACRO(change, bindings = <&out OUT_FN>;)
    ZMK_MACRO(fn_win, bindings = <&out OUT_FN_WIN>;)

    ZMK_MACRO(en_bootloader, bindings = <&bootloader>;)
    ZMK_MACRO1(MA,bindings=<&kp 0x770000>;)

    macro {

        in_below: in_below {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp END &kp LS(RET)>;
            label = "IN_BELOW";
        };

        in_above: in_above {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(RET) &kp UP>;
            label = "IN_ABOVE";
            wait-ms = <0>;
        };

        in_below_mac: in_below_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(RIGHT) &kp LS(RET)>;
            label = "IN_BELOW_MAC";
        };

        in_above_mac: in_above_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LEFT) &kp LS(RET) &kp UP>;
            label = "IN_ABOVE_MAC";
            wait-ms = <0>;
        };

        delete_to_row_start: delete_to_row_start {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(HOME) &kp BSPC>;
            label = "DELETE_TO_ROW_START";
        };

        lg_tog_colemak: lg_tog_colemak {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog 4 &kp LC(SPACE)>;
            label = "LG_TOG_COLEMAK";
        };

    };

    combos1 {
        compatible = "zmk,combos";

        combo_en_keep {
            bindings = <&kp LC(SPACE)>;
            key-positions = <9 10>;
            layers = <4>;
        };

        combo_ru_keep {
            bindings = <&kp LC(SPACE)>;
            key-positions = <10 11>;
            layers = <0 2>;
        };

        combo_en_switch {
            bindings = <&lg_tog_colemak>;
            key-positions = <9 10>;
            layers = <0 2>;
        };

        combo_ru_switch {
            bindings = <&lg_tog_colemak>;
            key-positions = <10 11>;
            layers = <4>;
        };

    };

    td0 {
        compatible = "zmk,behavior-tap-dance";
        label = "TAPD_LAYER";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings =<&mo 0>,<&mo 0>,<&mo 0>,<&mo 0>,<&to 0>;
    };
    ZMK_MACRO(bt_pair0, bindings = <&bt BT_PAIR 0>;)
    ZMK_MACRO(bt_pair1, bindings = <&bt BT_PAIR 1>;)
    ZMK_MACRO(bt_pair2, bindings = <&bt BT_PAIR 2>;)
    ZMK_MACRO(bt_pair3, bindings = <&bt BT_PAIR 3>;)
    ZMK_MACRO(bt_recon_0, bindings = <&bt BT_SEL 0>;)
    ZMK_MACRO(bt_recon_1, bindings = <&bt BT_SEL 1>;)
    ZMK_MACRO(bt_recon_2, bindings = <&bt BT_SEL 2>;)
    ZMK_MACRO(bt_recon_3, bindings = <&bt BT_SEL 3>;)



    bt_pair_0: bt_pair_0 {
        compatible = "zmk,behavior-hold-tap";
        label = "bt_pair0";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair0>, <&bt_recon_0>;
    };
    bt_pair_1: bt_pair_1 {
        compatible = "zmk,behavior-hold-tap";
        label = "bt_pair1";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair1>, <&bt_recon_1>;
    };
    bt_pair_2: bt_pair_2 {
        compatible = "zmk,behavior-hold-tap";
        label = "bt_pair2";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair2>, <&bt_recon_2>;
    };
    bt_pair_3: bt_pair_3 {
        compatible = "zmk,behavior-hold-tap";
        label = "bt_pair3";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair3>, <&bt_recon_3>;
    };
    uc:user_custom {
        compatible = "zmk,behavior-key-press";
        label ="user_custom";
        #binding-cells =<1>;
    };

	keymap {
    	compatible = "zmk,keymap";

        // 0
        mac {
        bindings = <
        &kp ESC     &kp F1                  &kp F2                  &kp F3                              &kp F4                  &kp F5              &kp F6          &kp F7          &kp F8              &kp F9      &kp F10     &kp F11             &kp F12             &kp DEL
        &kp GRAVE   &kp N1                  &kp N2                  &kp N3                              &kp N4                  &kp N5              &kp N6          &kp N7          &kp N8              &kp N9      &kp N0      &kp MINUS           &kp EQUAL           &kp BSPC
        &kp TAB     &kp Q                   &kp W                   &kp E                               &kp R                   &kp T               &kp Y           &kp U           &kp I               &kp O       &kp P       &kp LBKT            &kp RBKT            &kp BSLH
        &kp RGUI    &kp A                   &kp S                   &kp D                               &kp F                   &kp G               &kp H           &kp J           &kp K               &kp L       &kp SEMI    &kp SQT                         &kp RET
        &kp LSHFT   &kp Z                   &kp X                   &kp C                               &kp V                   &lt 5 B             &kp N           &kp M           &kp COMMA           &kp DOT     &kp FSLH                                    &kp RSHFT
        &kp LCTRL   &uc LALT                &uc LCMD                       &kp SPACE                                                                                                &uc RALT            &mo 1       &kp LEFT    &kp UP              &kp DOWN            &kp RIGHT
        &mo 2       &out OUT_BLE            &out OUT_24G            &out OUT_CHG                        &out OUT_CHGD
            >;
        };

       // 1
        mac_fn  {
        bindings = <
          //ESC         //f1                    //f2                //f3                                    //f4                //f5                //f6            //f7            //f8                //f9        //f10       //f11               //f12               //DEL
   &bootloader      &kp C_BRIGHTNESS_DEC    &kp C_BRIGHTNESS_INC    &kp LC(UP)                          &kp  LG(SPACE)          &kp C_AC_SEARCH     &kp LG(LC(Q))   &kp C_PREVIOUS  &kp C_PLAY_PAUSE    &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_DOWN   &kp C_VOLUME_UP     &trans
        &trans      &bt_pair_0 0 0          &bt_pair_1 0 0          &bt_pair_2 0 0                      &bt_pair_3 0 0          &trans              &trans          &trans          &trans              &trans      &trans      &trans              &kp C_AC_SEARCH     &trans
        &trans      &trans                  &trans                  &trans                              &trans                  &trans              &trans          &trans          &kp INS             &trans      &trans      &kp LG(LS(LBKT))    &kp LG(LS(RBKT))    &uc LG(LS(N4))
        &trans      &trans                  &trans                  &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans      &trans                      &trans
        &trans      &trans                  &trans                  &trans                              &trans                  &kp B               &trans          &trans          &trans              &trans      &trans                                  &uc LC(LG(SPACE))
        &trans      &trans                  &trans                         &trans                                                                                                   &kp RCTRL           &trans      &kp HOME   &kp PG_UP   &kp PG_DN    &kp END
        //
        &none       &none                   &none                   &none                               &none
            >;
        };

        // 2
        win {
        bindings = <
        &kp ESC     &kp F1                  &kp F2                  &kp F3                              &kp F4                  &kp F5              &kp F6          &kp F7          &kp F8              &kp F9      &kp F10     &kp F11             &kp F12             &kp DEL
        &kp GRAVE   &kp N1                  &kp N2                  &kp N3                              &kp N4                  &kp N5              &kp N6          &kp N7          &kp N8              &kp N9      &kp N0      &kp MINUS           &kp EQUAL           &kp BSPC
        &kp TAB     &kp Q                   &kp W                   &kp E                               &kp R                   &kp T               &kp Y           &kp U           &kp I               &kp O       &kp P       &kp LBKT            &kp RBKT            &kp BSLH
        &kp LCTRL   &kp A                   &kp S                   &kp D                               &kp F                   &kp G               &kp H           &kp J           &kp K               &kp L       &kp SEMI    &kp SQT                         &kp RET
        &kp LSHFT   &kp Z                   &kp X                   &kp C                               &kp V                   &lt 6 B             &kp N           &kp M           &kp COMMA           &kp DOT     &kp FSLH                                    &kp RSHFT
        &kp CAPS  	&kp LGUI               &kp LALT                      &kp SPACE              		                                                                                &kp RALT  	        &mo 3 		  &kp LEFT 	 &kp UP      &kp DOWN 	&kp RIGHT
        //
        &none       &out OUT_BLE           &out OUT_24G             &out OUT_CHG                        &out OUT_CHGD
            >;
        };

        // 3
        win_fn {
        bindings = <
                    //f1                    //f2                    //f3                                //f4                        //f5            //f6              //f7            //f8              //f9        //f10           //f11                         //f12
   &bootloader  &kp C_BRIGHTNESS_DEC    &kp C_BRIGHTNESS_INC        &uc LG(TAB)                         &uc C_AL_MY_COMPUTER    &kp C_AC_SEARCH     &uc LG(L)       &kp C_PREVIOUS  &kp C_PLAY_PAUSE    &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_DOWN           &kp C_VOLUME_UP      &trans
        &trans  &bt_pair_0 0 0          &bt_pair_1 0 0              &bt_pair_2 0 0                      &bt_pair_3 0 0          &trans              &trans          &trans          &trans              &trans      &trans      &trans                      &kp C_AL_CALC        &trans
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &kp INS             &trans      &trans      &kp LC(PG_UP)               &kp LC(PG_DN)        &uc PSCRN
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans      &trans                              &trans
        &trans  &trans                  &trans                      &trans                              &trans                  &kp B               &trans          &trans          &trans              &trans      &trans                                          &uc LG(DOT)
        &trans  &trans                  &trans                           &trans                                                                                                     &kp RCTRL           &trans      &kp HOME    &kp PG_UP    &kp PG_DN   &kp END
        //
        &none   &none                   &none                       &none                               &none
            >;
        };
        
        // 4
        colemak {
        bindings = <
        &trans      &trans                  &trans                  &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans      &trans              &trans              &trans
        &trans      &trans                  &trans                  &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans      &trans              &trans              &trans
        &trans      &kp Q                   &kp W                   &kp F                               &kp P                   &kp G               &kp J           &kp L           &kp U               &kp Y       &kp SEMI    &kp LBKT            &kp RBKT            &kp BSLH
        &trans      &kp A                   &kp R                   &kp S                               &kp T                   &kp D               &kp H           &kp N           &kp E               &kp I       &kp O       &kp SQT                         &trans
        &trans      &kp Z                   &kp X                   &kp C                               &kp V                   &trans              &kp K           &kp M           &kp COMMA           &kp DOT     &kp FSLH                                    &trans
        &trans      &trans                  &trans                         &trans                                                                                                   &trans              &trans      &trans      &trans              &trans      &trans
        //
        &trans      &trans                  &trans                      &trans                               &trans
            >;
        };

        // 5
        mac_navi {
        bindings = <
                      //f1                    //f2                    //f3                                //f4                        //f5            //f6              //f7            //f8              //f9                  //f10           //f11                         //f12
   &bootloader    &kp C_BRIGHTNESS_DEC    &kp C_BRIGHTNESS_INC        &kp LC(UP)                          &kp LG(SPACE)           &kp C_AC_SEARCH     &kp LG(LC(Q))   &kp C_PREVIOUS  &kp C_PLAY_PAUSE    &kp C_NEXT            &kp C_MUTE  &kp C_VOLUME_DOWN        &kp C_VOLUME_UP      &trans
        &trans    &kp F1                  &kp F2                      &kp F3                              &kp F4                  &kp F5              &kp F6          &kp F7          &kp F8              &kp F9                &kp F10     &kp F11                  &kp F12              &kp LG(BSPC)
        &trans    &kp LS(LG(UP))          &kp LS(LA(LEFT))            &kp LS(UP)                          &kp LS(LA(RIGHT))       &kp LS(LG(DOWN))    &kp LG(UP)      &kp LA(LEFT)    &kp UP              &kp LA(RIGHT)         &kp LG(DOWN)       &kp LG(LS(LBKT))  &kp LG(LS(RBKT))     &uc LG(LS(N4))
        &trans    &kp LS(LG(LEFT))        &kp LS(LEFT)                &kp LS(DOWN)                        &kp LS(RIGHT)           &kp LS(LG(RIGHT))   &kp LG(LEFT)    &kp LEFT        &kp DOWN            &kp RIGHT             &kp LG(RIGHT)      &uc LC(LG(SPACE))             &trans
        &trans    &kp BSPC                &in_above_mac               &kp LA(SPACE)                       &in_below_mac           &trans              &kp RET         &kp PG_UP       &kp LS(F10)         &kp PG_DN             &kp LG(LS(BSPC))                                 &uc LC(LG(SPACE))
        &trans    &trans                  &trans                           &trans                                                                                                     &trans              &trans                &kp HOME    &kp PG_UP    &kp PG_DN   &kp END
        //
        &none     &none                   &none                       &none                               &none
            >;
        };

        // 6
        win_navi {
        bindings = <
                      //f1                    //f2                    //f3                                //f4                        //f5            //f6              //f7            //f8              //f9                  //f10           //f11                         //f12
   &bootloader    &kp C_BRIGHTNESS_DEC    &kp C_BRIGHTNESS_INC        &uc LG(TAB)                         &uc C_AL_MY_COMPUTER    &kp C_AC_SEARCH     &uc LG(L)       &kp C_PREVIOUS  &kp C_PLAY_PAUSE    &kp C_NEXT            &kp C_MUTE  &kp C_VOLUME_DOWN           &kp C_VOLUME_UP      &trans
        &trans    &kp F1                  &kp F2                      &kp F3                              &kp F4                  &kp F5              &kp F6          &kp F7          &kp F8              &kp F9                &kp F10     &kp F11                     &kp F12              &delete_to_row_start
        &trans    &kp LS(LC(HOME))        &kp LS(LC(LEFT))            &kp LS(UP)                          &kp LS(LC(RIGHT))       &kp LS(LC(END))     &kp LC(HOME)    &kp LC(LEFT)    &kp UP              &kp LC(RIGHT)         &kp LC(END) &kp LC(PG_UP)               &kp LC(PG_DN)        &uc PSCRN
        &trans    &kp LS(HOME)            &kp LS(LEFT)                &kp LS(DOWN)                        &kp LS(RIGHT)           &kp LS(END)         &kp HOME        &kp LEFT        &kp DOWN            &kp RIGHT             &kp END     &uc LG(DOT)                             &trans
        &trans    &kp DEL                 &in_above                   &kp LG(LC(LS(LALT)))                &in_below               &trans              &kp RET         &kp PG_UP       &kp LS(F10)         &kp PG_DN             &kp LS(DEL)                                         &uc LG(DOT)
        &trans    &trans                  &trans                           &trans                                                                                                     &trans              &trans                &kp HOME    &kp PG_UP    &kp PG_DN   &kp END
        //
        &none     &none                   &none                       &none                               &none
            >;
        };

        // 7
        seventh {
        bindings = <
                    //f1                    //f2                    //f3                                //f4                        //f5            //f6              //f7            //f8              //f9        //f10           //f11                         //f12
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans      &trans                      &trans               &trans
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans      &trans                      &trans               &trans
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans      &trans                      &trans               &trans
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans      &trans                              &trans
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans                                          &trans
        &trans  &trans                  &trans                           &trans                                                                                                     &trans              &trans      &trans      &trans       &trans      &trans
        //
        &none   &none                   &none                       &none                               &none
            >;
        };

	};
};


