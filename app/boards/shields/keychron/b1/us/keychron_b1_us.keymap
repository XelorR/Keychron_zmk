#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    ZMK_MACRO(recover, bindings = <&out OUT_RECOVER>;)
    ZMK_MACRO(change, bindings = <&out OUT_FN>;)
    ZMK_MACRO(fn_win, bindings = <&out OUT_FN_WIN>;)

    ZMK_MACRO(en_bootloader, bindings = <&bootloader>;)
    ZMK_MACRO1(MA,bindings=<&kp 0x770000>;)

    macro {

        cmd_space_lang1: cmd_space_lang1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(N7))>;
            label = "CMD_SPACE_LANG1";
        };

        cmd_space_lang2: cmd_space_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(N8))>;
            label = "CMD_SPACE_LANG2";
        };

        ctrl_space_lang1: ctrl_space_lang1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "CTRL_SPACE_LANG1";
        };

        ctrl_space_lang2: ctrl_space_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "CTRL_SPACE_LANG2";
        };

        in_below: in_below {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp END &kp LS(RET)>;
            label = "IN_BELOW";
        };

        in_above: in_above {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(RET) &kp UP>;
            label = "IN_ABOVE";
            wait-ms = <0>;
        };

        in_below_mac: in_below_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(RIGHT) &kp LS(RET)>;
            label = "IN_BELOW_MAC";
        };

        in_above_mac: in_above_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LEFT) &kp LS(RET) &kp UP>;
            label = "IN_ABOVE_MAC";
            wait-ms = <0>;
        };

        delete_to_row_start: delete_to_row_start {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(HOME) &kp BSPC>;
            label = "DELETE_TO_ROW_START";
        };

        lg_tog_colemak: lg_tog_colemak {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog 4 &kp LC(SPACE)>;
            label = "LG_TOG_COLEMAK";
        };

    };

    combos1 {
        compatible = "zmk,combos";

        combo_en_keep {
            bindings = <&kp LC(SPACE)>;
            key-positions = <5 6>;
            layers = <4>;
        };

        combo_ru_keep {
            bindings = <&kp LC(SPACE)>;
            key-positions = <6 7>;
            layers = <0 2>;
        };

        combo_en_switch {
            bindings = <&lg_tog_colemak>;
            key-positions = <5 6>;
            layers = <0 2>;
        };

        combo_ru_switch {
            bindings = <&lg_tog_colemak>;
            key-positions = <6 7>;
            layers = <4>;
        };

        combo_typing_keep {
            bindings = <&none>;
            key-positions = <9 10>;
            layers = <0 2>;
        };

        combo_gaming_keep {
            bindings = <&none>;
            key-positions = <10 11>;
            layers = <7>;
        };

        combo_typing_switch {
            bindings = <&tog 7>;
            key-positions = <9 10>;
            layers = <7>;
        };

        combo_gaming_switch {
            bindings = <&tog 7>;
            key-positions = <10 11>;
            layers = <0 2>;
        };

        win_lg1 {
            bindings = <&cmd_space_lang1>;
            key-positions = <30 32>;
            layers = <0 2>;
        };

        win_lg2 {
            bindings = <&cmd_space_lang2>;
            key-positions = <35 37>;
            layers = <0 2>;
        };

        mac_lg1 {
            bindings = <&ctrl_space_lang1>;
            key-positions = <57 59>;
            layers = <0 2>;
        };

        mac_lg2 {
            bindings = <&ctrl_space_lang2>;
            key-positions = <62 24>;
            layers = <0 2>;
        };
    };

    behaviors {
   
        home_mac: home_mac {
            compatible = "zmk,behavior-mod-morph";
            label = "HOME_MAC";
            bindings = <&kp LG(LEFT)>, <&kp LG(UP)>;
            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <0>;
        };

        end_mac: end_mac {
            compatible = "zmk,behavior-mod-morph";
            label = "END_MAC";
            bindings = <&kp LG(RIGHT)>, <&kp LG(DOWN)>;
            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <0>;
        };

        pgup_mac: pgup_mac {
            compatible = "zmk,behavior-mod-morph";
            label = "PGUP_MAC";
            bindings = <&kp PG_UP>, <&kp LG(LS(LBKT))>;
            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <0>;
        };

        pgdn_mac: pgdn_mac {
            compatible = "zmk,behavior-mod-morph";
            label = "PGDN_MAC";
            bindings = <&kp PG_DN>, <&kp LG(LS(RBKT))>;
            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <0>;
        };

    };

    td0 {
        compatible = "zmk,behavior-tap-dance";
        label = "TAPD_LAYER";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings =<&mo 0>,<&mo 0>,<&mo 0>,<&mo 0>,<&to 0>;
    };
    ZMK_MACRO(bt_pair0, bindings = <&bt BT_PAIR 0>;)
    ZMK_MACRO(bt_pair1, bindings = <&bt BT_PAIR 1>;)
    ZMK_MACRO(bt_pair2, bindings = <&bt BT_PAIR 2>;)
    ZMK_MACRO(bt_pair3, bindings = <&bt BT_PAIR 3>;)
    ZMK_MACRO(bt_recon_0, bindings = <&bt BT_SEL 0>;)
    ZMK_MACRO(bt_recon_1, bindings = <&bt BT_SEL 1>;)
    ZMK_MACRO(bt_recon_2, bindings = <&bt BT_SEL 2>;)
    ZMK_MACRO(bt_recon_3, bindings = <&bt BT_SEL 3>;)



    bt_pair_0: bt_pair_0 {
        compatible = "zmk,behavior-hold-tap";
        label = "bt_pair0";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair0>, <&bt_recon_0>;
    };
    bt_pair_1: bt_pair_1 {
        compatible = "zmk,behavior-hold-tap";
        label = "bt_pair1";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair1>, <&bt_recon_1>;
    };
    bt_pair_2: bt_pair_2 {
        compatible = "zmk,behavior-hold-tap";
        label = "bt_pair2";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair2>, <&bt_recon_2>;
    };
    bt_pair_3: bt_pair_3 {
        compatible = "zmk,behavior-hold-tap";
        label = "bt_pair3";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair3>, <&bt_recon_3>;
    };
    uc:user_custom {
        compatible = "zmk,behavior-key-press";
        label ="user_custom";
        #binding-cells =<1>;
    };

	keymap {
    	compatible = "zmk,keymap";

        // 0
        BASE {
        bindings = <
        &kp ESC   &kp F1     &kp F2     &kp F3      &kp F4      &kp F5     &kp F6     &kp F7      &kp F8      &kp F9     &kp F10    &kp F11   &kp F12   &kp DEL
        &kp GRAVE &kp LS(N1) &kp LS(N2) &kp LS(N3)  &kp LS(N4)  &kp LS(N5) &kp LS(N6) &kp LS(N7)  &kp LS(N8)  &kp LS(N9) &kp LS(N0) &kp MINUS &kp EQUAL &kp BSPC
        &kp TAB   &kp Q      &kp W      &kp F       &kp P       &kp G      &kp J      &kp L       &kp U       &kp Y      &kp SEMI   &kp LBKT  &kp RBKT  &kp BSLH
        &kp ESC   &mt LGUI A &mt LALT R &mt LCTRL S &mt LSHFT F &kp D      &kp H      &mt LSHFT N &mt LCTRL E &mt LALT I &mt LGUI O &kp SQT   &kp RET
        &kp LSHFT &kp Z      &kp X      &kp C       &kp V       &kp B      &kp K      &kp M       &kp COMMA   &kp DOT    &kp FSLH   &kp RSHFT
        &kp LCTRL &kp LGUI   &kp LALT         &lt 6 SPACE                                         &kp RALT    &mo 3 	   &kp LEFT   &kp UP    &kp DOWN 	&kp RIGHT
        //
        &none     &out OUT_BLE  &out OUT_24G  &out OUT_CHG  &out OUT_CHGD
            >;
        };

        // 1
        EXTRA {
        bindings = <
                   //f1       //f2       //f3        //f4        //f5    //f6    //f7       //f8        //f9       //f10         //f11   //f12
        &trans    &trans     &trans     &trans      &trans      &trans  &trans &trans      &trans      &trans     &trans        &trans  &trans  &trans
        &kp GRAVE &trans     &trans     &trans      &trans      &trans  &trans &trans      &trans      &trans     &trans        &trans  &trans  &trans
        &kp TAB   &kp Q      &kp W      &kp E       &kp R       &kp T   &kp Y  &kp U       &kp I       &kp O      &kp P         &trans  &trans  &trans
        &kp CAPS  &kp LGUI A &kp LALT S &kp LCTRL D &kp LSHFT F &kp G   &kp H  &kp LSHFT J &kp LCTRL K &kp LALT L &kp LGUI SEMI &kp SQT &trans
        &kp LSHFT &kp Z      &kp X      &kp C       &kp V       &kp B   &kp N  &kp M       &kp COMMA   &kp DOT    &kp FSLH      &trans
        &kp LCTRL &trans     &trans           &lt 6 SPACE                                  &trans      &trans     &trans        &trans  &trans  &trans
        //
        &none     &out OUT_BLE  &out OUT_24G  &out OUT_CHG  &out OUT_CHGD
            >;
        };

        // 2
        SHORTCUT {
        bindings = <
                   //f1       //f2       //f3        //f4        //f5    //f6    //f7       //f8        //f9       //f10         //f11   //f12
        &trans    &trans     &trans     &trans      &trans      &trans  &trans &trans      &trans      &trans     &trans        &trans  &trans  &trans
        &kp GRAVE &trans     &trans     &trans      &trans      &trans  &trans &trans      &trans      &trans     &trans        &trans  &trans  &trans
        &kp TAB   &kp Q      &kp W      &kp F       &kp P       &kp G   &kp J  &kp L       &kp U       &kp Y      &kp SEMI      &trans  &trans  &trans
        &kp CAPS  &kp LGUI A &kp LALT R &kp LCTRL S &kp LSHFT T &kp D   &kp H  &kp LSHFT N &kp LCTRL E &kp LALT I &kp LGUI O    &kp SQT &trans
        &kp LSHFT &kp Z      &kp X      &kp C       &kp V       &kp B   &kp K  &kp M       &kp COMMA   &kp DOT    &kp FSLH      &trans
        &kp LCTRL &trans     &trans           &kp SPACE                                    &trans      &trans     &trans        &trans  &trans  &trans
        //
        &none     &none   &none   &none  &none
            >;
        };

        // 3
        TAP {
        bindings = <
                    //f1    //f2    //f3    //f4    //f5    //f6    //f7    //f8    //f9    //f10     //f11   //f12
        &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans   &trans  &trans  &trans
        &kp GRAVE &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans   &trans  &trans  &trans
        &kp TAB   &kp Q   &kp W   &kp F   &kp P   &kp G   &kp J   &kp L   &kp U     &kp Y   &kp SEMI &trans  &trans  &trans
        &kp CAPS  &kp A   &kp R   &kp S   &kp T   &kp D   &kp H   &kp N   &kp E     &kp I   &kp O    &kp SQT &trans
        &kp LSHFT &kp Z   &kp X   &kp C   &kp V   &kp B   &kp K   &kp M   &kp COMMA &kp DOT &kp FSLH &trans
        &kp LCTRL &trans  &trans        &kp SPACE                         &trans    &trans  &trans   &trans  &trans  &trans
        //
        &none     &out OUT_BLE  &out OUT_24G  &out OUT_CHG  &out OUT_CHGD
            >;
        };
        
        // 4
        BUTTON {
        bindings = <
                    //f1                    //f2                    //f3                                //f4                        //f5            //f6              //f7            //f8              //f9        //f10           //f11                         //f12
   &bootloader  &kp C_BRIGHTNESS_DEC    &kp C_BRIGHTNESS_INC        &uc LG(TAB)                         &uc C_AL_MY_COMPUTER    &kp C_AC_SEARCH     &uc LG(L)       &kp C_PREVIOUS  &kp C_PLAY_PAUSE    &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_DOWN           &kp C_VOLUME_UP      &trans
        &trans  &bt_pair_0 0 0          &bt_pair_1 0 0              &bt_pair_2 0 0                      &bt_pair_3 0 0          &trans              &trans          &trans          &trans              &trans      &trans      &trans                      &kp C_AL_CALC        &trans
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &kp INS             &trans      &trans      &kp LC(PG_UP)               &kp LC(PG_DN)        &uc PSCRN
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans      &trans                              &trans
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans                                          &uc LG(DOT)
        &trans  &trans                  &trans                           &trans                                                                                                     &kp RCTRL           &trans      &kp HOME    &kp PG_UP    &kp PG_DN   &kp END
        //
        &none   &none                   &none                       &none                               &none
            >;
        };
        
        // 5
        NUMNAV {
        bindings = <
                    //f1                    //f2                    //f3                                //f4                        //f5            //f6              //f7            //f8              //f9        //f10           //f11                         //f12
   &bootloader  &kp C_BRIGHTNESS_DEC    &kp C_BRIGHTNESS_INC        &uc LG(TAB)                         &uc C_AL_MY_COMPUTER    &kp C_AC_SEARCH     &uc LG(L)       &kp C_PREVIOUS  &kp C_PLAY_PAUSE    &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_DOWN           &kp C_VOLUME_UP      &trans
        &trans  &bt_pair_0 0 0          &bt_pair_1 0 0              &bt_pair_2 0 0                      &bt_pair_3 0 0          &trans              &trans          &trans          &trans              &trans      &trans      &trans                      &kp C_AL_CALC        &trans
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &kp INS             &trans      &trans      &kp LC(PG_UP)               &kp LC(PG_DN)        &uc PSCRN
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans      &trans                              &trans
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans                                          &uc LG(DOT)
        &trans  &trans                  &trans                           &trans                                                                                                     &kp RCTRL           &trans      &kp HOME    &kp PG_UP    &kp PG_DN   &kp END
        //
        &none   &none                   &none                       &none                               &none
            >;
        };
        
        // 6
        FUNMED {
        bindings = <
                    //f1                    //f2                    //f3                                //f4                        //f5            //f6              //f7            //f8              //f9        //f10           //f11                         //f12
   &bootloader  &kp C_BRIGHTNESS_DEC    &kp C_BRIGHTNESS_INC        &uc LG(TAB)                         &uc C_AL_MY_COMPUTER    &kp C_AC_SEARCH     &uc LG(L)       &kp C_PREVIOUS  &kp C_PLAY_PAUSE    &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_DOWN           &kp C_VOLUME_UP      &trans
        &trans  &bt_pair_0 0 0          &bt_pair_1 0 0              &bt_pair_2 0 0                      &bt_pair_3 0 0          &trans              &trans          &trans          &trans              &trans      &trans      &trans                      &kp C_AL_CALC        &trans
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &kp INS             &trans      &trans      &kp LC(PG_UP)               &kp LC(PG_DN)        &uc PSCRN
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans      &trans                              &trans
        &trans  &trans                  &trans                      &trans                              &trans                  &trans              &trans          &trans          &trans              &trans      &trans                                          &uc LG(DOT)
        &trans  &trans                  &trans                           &trans                                                                                                     &kp RCTRL           &trans      &kp HOME    &kp PG_UP    &kp PG_DN   &kp END
        //
        &none   &none                   &none                       &none                               &none
            >;
        };
        
	};
};


